# Server
PORT=3000
NODE_ENV=development

# Public API URL (used in Swagger "Try it out"; defaults to http://localhost:PORT)
# PUBLIC_API_URL=https://api.example.com

# Logging
LOG_LEVEL=info

# CORS (use your Expo / web origin in production, e.g. http://localhost:8081)
CORS_ORIGIN=*

# PostgreSQL (used by TypeORM in database.config.ts)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=levelup

# Auth (set JWT_SECRET to a long random string in production)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Redis (rate-limit.middleware.ts) — optional; defaults to redis://127.0.0.1:6379
# REDIS_URL=redis://127.0.0.1:6379